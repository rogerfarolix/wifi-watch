{
  "name": "wifi-watch-desktop",
  "version": "2.0.1",
  "author": "Nealix",
  "description": "Wifi-Watch — Cyber Sentinel & Surveillance Réseau Temps Réel",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "build": {
    "appId": "com.nealix.wifiwatch",
    "productName": "Wifi-Watch",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "src/renderer/assets/icon.ico"
    },
    "portable": {
      "artifactName": "Wifi-Watch-Portable.exe"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "lucide": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0"
  }
}
